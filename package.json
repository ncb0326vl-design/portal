  "scripts": {
    "build": "cross-env HOST=local NODE_OPTIONS=--openssl-legacy-provider webpack --config webpack/prod.js",
    "build:uat": "cross-env HOST=uat NODE_OPTIONS=--openssl-legacy-provider webpack --config webpack/prod.js",
    "start": "cross-env HOST=local BABEL_ENV=hmr DEV_SESSION=1 NODE_OPTIONS=--openssl-legacy-provider webpack-dev-server --inline --hot --history-api-fallback --progress --config webpack/dev.js",
    "start:proxy": "cross-env HOST=local-proxy BABEL_ENV=hmr DEV_SESSION=1 NODE_OPTIONS=--openssl-legacy-provider webpack-dev-server --inline --hot --history-api-fallback --progress --config webpack/dev.js"
  },
